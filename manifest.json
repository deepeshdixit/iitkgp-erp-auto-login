{
  "manifest_version": 3,
  "name": "IIT KGP ERP Auto-Login",
  "version": "1.0.1",
  "description": "Secure, PIN-protected autofill extension for IIT Kharagpur ERP with dynamic security question matching.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://erp.iitkgp.ac.in/*",
    "http://erp.iitkgp.ac.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "IIT KGP ERP Auto-Login",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.iitkgp.ac.in/*",
        "http://erp.iitkgp.ac.in/*"
      ],
      "js": [
        "crypto.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
